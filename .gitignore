# ═══════════════════════════════════════════════════════════════════════
# .gitignore — Reseller OS / JunaShop
# ═══════════════════════════════════════════════════════════════════════

# Dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
/build

# Production
*.tsbuildinfo
next-env.d.ts

# Misc
.DS_Store
*.pem
Thumbs.db

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev.log
dev.out.log
server.log
test

# ═══════════════════════════════════════════════════════════════════════
# 🔒 SENSITIVE FILES — NE JAMAIS COMMITTER
# ═══════════════════════════════════════════════════════════════════════

# Environment variables (secrets SMTP, NextAuth, etc.)
.env
.env.*
!.env.example

# Database (données de production — JAMAIS dans Git)
db/*.db
db/*.db-journal
db/*.db.backup*
prisma/db/*.db
prisma/db/*.db-journal
prisma/db/*.db.backup*

# Backups
backups/
*.backup
*.backup_*

# Photo uploads (user data)
public/uploads/
public/uploads/sessions/
public/uploads/boutique-hero/
public/uploads/boutique-logo/
public/uploads/boutique-categories/

# ═══════════════════════════════════════════════════════════════════════
# 🖥️ SERVER-SPECIFIC (config panel, scripts locaux)
# ═══════════════════════════════════════════════════════════════════════

.user.ini
reseller-os.zip
reseller-os.tar.gz
deploy.sh
diag.sh
update.sh

# Skills / agent context (dev only)
/skills/
/agent-ctx/
.claude
.z-ai-config
local-*
prompt
